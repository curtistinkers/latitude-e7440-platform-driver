[Unit]
Description=Intel backlight brightness handler service

[Service]
Type=oneshot
ExecStart=/usr/libexec/latitude-e7440-platform-driver/brightness-keys-handler.sh %i
RemainAfterExit=no
StandardInput=null
StandardOutput=journal
StandardError=journal

# Grant minimal capabilities
CapabilityBoundingSet=
AmbientCapabilities=

# Strict path whitelisting
ReadWritePaths=/sys/class/backlight/intel_backlight/brightness

# System call filtering (Allowing mandatory tools like dd, cat, od)
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

# Kernel and network lockdown
RestrictAddressFamilies=none
RestrictNamespaces=yes
RestrictRealtime=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
PrivateNetwork=yes
IPAddressDeny=any
ProtectHostname=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes

# Filesystem isolation
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
PrivateTmp=yes
PrivateUsers=yes
RestrictSUIDSGID=yes
UMask=0077
MountFlags=private

# Lockdown devices
PrivateDevices=yes
DevicePolicy=strict
DeviceAllow=/dev/null rw

# Prevent privilege escalation
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
